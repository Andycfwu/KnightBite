{
  "name": "knightbite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx --tsconfig tsconfig.test.json --require ./tests/support/synthetic-network.cjs --test --test-timeout=10000 tests/*.test.tsx",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test:browser": "playwright test && playwright test --config playwright.unavailable.config.ts",
    "build:isolated": "node scripts/isolated-build.mjs",
    "check": "npm test && npm run typecheck && npm run lint && npm run build:isolated && npm run test:browser && npm run check:preview",
    "prebuild": "node scripts/verify-runtime.mts",
    "check:preview": "node scripts/preview-verification.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "15.5.25",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2",
    "typescript-eslint": "8.70.0"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  }
}
